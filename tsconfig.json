{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "shadewind": ["./src/index"],
      "shadewind/internal": ["./src/internal"],
      "shadewind/diagnostics": ["./src/diagnostics"],
      "shadewind/uniwind": ["./src/uniwind/index"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": [
      "shadewind-source",
      "react-native-strict-api"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  },
  "exclude": ["example", "example-real", "lib", "node_modules"]
}
